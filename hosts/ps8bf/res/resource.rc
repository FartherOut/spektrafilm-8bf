/* SPDX-License-Identifier: GPL-3.0-or-later */
/* resource.rc — Windows resources for the spektrafilm .8bf.
 *
 * Contents
 *   - PiPL           user-defined resource of type "PiPL" (id 16000), the
 *                    Plug-in Property List Photoshop/Affinity read *without*
 *                    executing the DLL. Generated by tools/gen_pipl.py.
 *   - StringFileInfo version info.
 *
 * The bare `PiPL` token is a user-defined resource *type*; this is exactly
 * what Adobe's Cnvtpipl.exe emits (`16000  PiPL  DISCARDABLE` + data). It is
 * accepted by MS rc.exe, llvm-rc and windres; the quoted form ("PiPL") is
 * NOT accepted by llvm-rc, so we keep the bare form.
 *
 * The data pack (spectra_lut.f32, profiles/ *.json, pack.json) is appended by
 * the build as RCDATA resources - see res/pack.rc, produced by
 * `tools/gen_assets.py --win`.
 *
 * The parameter UI is Dear ImGui + Direct3D 11 (src/sf_gui_imgui.cpp): it is
 * drawn at runtime and needs no dialog-template resource. Groups/labels follow
 * the OFX plug-in's parameter surface (SpektraFilmPlugin.cpp) so the two UIs
 * read the same.
 */
#include <windows.h>

/* ---------------------------------------------------------------- PiPL -- */
/* Hosts enumerate resources of type "PiPL"; the id is arbitrary (Adobe's own
 * samples range over 16000/18008). PiPL data is regenerated by gen_pipl.py. */
16000   PiPL    "pipl.bin"

/* --------------------------------------------------------- version info -- */
/* Keep in sync with src/version.h. */
VS_VERSION_INFO VERSIONINFO
 FILEVERSION     0,1,0,0
 PRODUCTVERSION  0,1,0,0
 FILEFLAGSMASK   0x3fL
 FILEFLAGS       0x0L
 FILEOS          0x40004L
 FILETYPE        0x2L
 FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            /* The brand is spektrafilm; this port of it is the project
             * spektrafilm-8bf, so the product name carries the suffix and the
             * description carries the brand. All lowercase, as upstream writes
             * it. Keep the numbers in sync with src/version.h. */
            VALUE "CompanyName",      "spektrafilm\0"
            VALUE "FileDescription",  "spektrafilm film simulation filter\0"
            VALUE "FileVersion",      "0.1.0\0"
            VALUE "InternalName",     "spektrafilm\0"
            VALUE "OriginalFilename", "spektrafilm.8bf\0"
            VALUE "ProductName",      "spektrafilm-8bf\0"
            VALUE "ProductVersion",   "0.1.0\0"
            VALUE "LegalCopyright",   "Engine GPL-3.0-or-later; data pack CC BY-SA 4.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
